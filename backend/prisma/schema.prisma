// DayFlow database schema.
//
// Date handling note: anything that represents a calendar day (task due dates,
// timetable days, habit log days) is stored as @db.Date, not a timestamp. A
// timestamp would shift across timezones and silently move "due today" into
// yesterday for anyone east of UTC. Times-of-day are stored as minutes from
// midnight instead of a time type -- see TimetableEvent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection, used by the running app.
  url = env("DATABASE_URL")
  // Direct (non-pooled) connection. Supabase's pgbouncer cannot run DDL, so
  // migrations need this one. On a plain Postgres both can be the same URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique
  // Nullable on purpose: an account created through Google OAuth later will
  // never have a password. Non-null here would force a migration then.
  passwordHash String?
  name         String
  createdAt    DateTime @default(now())

  tasks         Task[]
  events        TimetableEvent[]
  habits        Habit[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Access tokens are stateless and short-lived. Refresh tokens live here so
// that logout can actually revoke a session instead of trusting the client to
// forget it. Only the SHA-256 hash is stored, never the token itself.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id      String  @id @default(cuid())
  userId  String
  title   String
  notes   String?
  // Null due date means "Someday" in the UI grouping.
  dueDate     DateTime? @db.Date
  priority    Priority  @default(MEDIUM)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed, dueDate])
  @@map("tasks")
}

// Start/end are minutes from midnight (0-1439) rather than a time column.
// The day view is an hourly grid from 6am (360) to 11pm (1380), and integer
// minutes make positioning, overlap checks and duration maths trivial in JS
// without dragging a timezone into every comparison.
model TimetableEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  date        DateTime @db.Date
  startMinute Int
  endMinute   Int
  colorTag    String   @default("blue")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("timetable_events")
}

// v1 ships DAILY only. WEEKDAYS exists so the streak logic and the schema
// already have a shape to grow into -- targetDays holds 0-6 (Sun-Sat) and is
// ignored while frequency is DAILY.
enum HabitFrequency {
  DAILY
  WEEKDAYS
}

model Habit {
  id         String         @id @default(cuid())
  userId     String
  name       String
  frequency  HabitFrequency @default(DAILY)
  targetDays Int[]          @default([])
  colorTag   String         @default("green")
  archived   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, archived])
  @@map("habits")
}

// One row per habit per day. The compound unique is what makes the toggle
// endpoint an idempotent upsert rather than a read-then-write race.
// Ownership is reached through Habit -- every query must join to check userId.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @db.Date
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
  @@map("habit_logs")
}
