# ---------------------------------------------------------------------------
# DayFlow backend environment
# Copy to .env and fill in. .env is gitignored; this file is not.
# ---------------------------------------------------------------------------

# Postgres connection used by the running app.
# Supabase: Project Settings -> Database -> Connection string -> "Transaction"
# pooler (port 6543). Keep ?pgbouncer=true on it.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct, non-pooled connection (port 5432). Prisma Migrate needs this because
# pgbouncer in transaction mode cannot run DDL. On a plain local Postgres this
# can be identical to DATABASE_URL.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secrets for signing tokens. MUST be different from each other, and must be
# replaced with real random values -- generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-long-random-string"

# Token lifetimes. Access tokens stay short because they cannot be revoked.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

PORT="4000"
NODE_ENV="development"

# Comma-separated list of origins allowed to send credentialed requests.
# Expo web dev server defaults to 8081.
CORS_ORIGINS="http://localhost:8081,http://localhost:19006"

# Set to "true" only when the API is served over HTTPS. Controls the Secure
# flag on the refresh-token cookie.
COOKIE_SECURE="false"
